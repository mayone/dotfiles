# Linked to ~/.config/ghostty/config.ghostty by ghostty/apply.sh
# The values come from the iTerm2 profile that Ghostty replaces. Run
# `ghostty +show-config --default --docs` for all options and their defaults

# MesloLGS NF is the Powerlevel10k font. Ghostty skips a family that is not
# installed, so a Mac without it and NixOS use the Nerd Fonts version
font-family = MesloLGS NF
font-family = MesloLGS Nerd Font Mono
font-size = 16

# The iTerm2 colors are Builtin Dark with a different blue
theme = Builtin Dark
palette = 4=#0000bb
# Bold text in the default color is white, and other bold text uses the
# bright colors
bold-color = #ffffff

window-width = 100
window-height = 25

# A block cursor that does not blink, also at the prompt
cursor-style-blink = false
shell-integration-features = no-cursor

# As in iTerm2. SSH hosts and sudo do not always find the terminfo entry of
# the default, xterm-ghostty
term = xterm-256color

copy-on-select = clipboard
confirm-close-surface = false

# New windows, tabs, and splits open in the home directory
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = false
